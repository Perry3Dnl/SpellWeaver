[Unit]
Description=SpellWeaver Static Editor
After=network.target
[Service]
Type=simple
WorkingDirectory=/opt/spellweaver/current
ExecStart=/usr/bin/python3 -m http.server 18087 --bind 127.0.0.1 --directory /opt/spellweaver/current
Restart=always
RestartSec=3
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadOnlyPaths=/opt/spellweaver
PrivateTmp=yes
[Install]
WantedBy=multi-user.target
